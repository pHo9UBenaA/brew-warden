# Ignore files by default; traverse directories to reach explicit exceptions.
*
!*/

# Public root files.
!/.gitignore
!/.editorconfig
!/AGENTS.md
!/CONTRIBUTING.md
!/README.md
!/go.mod
!/.go-version
!/Taskfile.yml

# Reviewed design and development documentation.
!/docs/design.md
!/docs/architecture.md
!/docs/homebrew-integration.md
!/docs/dependencies.md
!/docs/archive/initial-research.md
!/docs/archive/language-evaluation.md
!/docs/archive/jev-evaluation.md
!/docs/threat-model.md
!/docs/verification.md

# Public automation and agent instructions.
!/.github/workflows/verify.yml
!/.github/dependabot.yml
!/.githooks/commit-msg
!/.githooks/pre-commit
!/.githooks/pre-push
!/.agents/skills/brewwarden-change/SKILL.md
!/.agents/skills/brewwarden-review/SKILL.md
!/scripts/setup-hooks.sh
!/scripts/verify.sh
!/scripts/env.sh
!/scripts/tool-versions.env
!/scripts/setup-tools.sh
!/scripts/check.sh
!/scripts/probe-homebrew.sh
!/scripts/homebrew-probe.md

# Diagnostic-only product entrypoints and their execution refusal tests.
!/cmd/bwd/main.go
!/cmd/brewwarden/main.go
!/internal/cli/run.go
!/internal/cli/run_test.go
!/internal/composition/main.go
!/tests/cli_test.go
!/internal/domain/policy.go
!/internal/domain/evidence.go
!/internal/domain/decision.go
!/tests/policy_test.go
!/internal/ports/config.go
!/internal/adapters/localstate/json.go
!/internal/adapters/localstate/config.go
!/internal/adapters/localstate/config_test.go
!/internal/adapters/localstate/files.go
!/internal/adapters/localstate/files_test.go

# Development tooling. Add new source files explicitly when introducing them.
!/tools/repo-check/architecture.go
!/tools/repo-check/architecture_test.go
!/tools/repo-check/commit.go
!/tools/repo-check/commit_test.go
!/tools/repo-check/fuzz_test.go
!/tools/repo-check/hygiene_test.go
!/tools/repo-check/hooks_test.go
!/tools/repo-check/scripts_test.go
!/tools/repo-check/hygiene.go
!/tools/repo-check/main.go

# Prune generated trees rather than traversing them.
/.cache/
/bin/
/dist/

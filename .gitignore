# Ignore unlisted root entries, including their contents.
/*

# Public root files.
!/.gitignore
!/.editorconfig
!/AGENTS.md
!/CONTRIBUTING.md
!/README.md
!/LICENSE
!/go.mod
!/.go-version
!/Taskfile.yml

# Track public source, documentation and tooling trees recursively.
!/cmd/
!/internal/
!/tests/
!/tools/
!/docs/
!/scripts/
!/.github/
!/.githooks/

# Publish skills without including other local agent configuration.
!/.agents/
/.agents/*
!/.agents/skills/

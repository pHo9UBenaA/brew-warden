#!/bin/sh
set -eu
./scripts/verify.sh
export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOWORK=off GOFLAGS=-mod=readonly CGO_ENABLED=0
export GOCACHE="${GOCACHE:-$(git rev-parse --show-toplevel)/.cache/go-build}"
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  tip=$(git rev-parse --verify "$local_oid^{commit}")
  case "$remote_oid" in
    *[!0]*)
      if ! base=$(git rev-parse --verify "$remote_oid^{commit}"); then
        printf 'Fetch the remote ref before validating its commit range.\n' >&2
        exit 1
      fi
      go run ./tools/repo-check commits "$tip" "$base"
      ;;
    *) go run ./tools/repo-check commits "$tip" ;;
  esac
done
